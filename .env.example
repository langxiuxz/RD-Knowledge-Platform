# Docker Compose configuration. Replace every placeholder before deployment.
MYSQL_ROOT_PASSWORD=replace-with-a-random-db-password
DB_NAME=study_agent
REDIS_PASSWORD=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
INTERNAL_TOKEN=replace-with-a-random-internal-token
WEB_PORT=80

# Milvus private deployment. These credentials are only for its internal object store.
MILVUS_MINIO_USER=replace-with-a-minio-user
MILVUS_MINIO_PASSWORD=replace-with-a-random-minio-password
# Container address; host-based FastAPI instead uses http://localhost:19530.
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_COLLECTION=study_agent_local_hash_v1
MILVUS_TIMEOUT=10

LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.deepseek.com

# Interrupted task state recovery (Spring Boot)
TASK_RECOVERY_ENABLED=true
TASK_RECOVERY_SCAN_INTERVAL=30s
TASK_RECOVERY_DOCUMENT_TIMEOUT=15m
TASK_RECOVERY_GENERATION_TIMEOUT=5m
TASK_RECOVERY_BATCH_SIZE=100
# Maximum total deliveries per document callback (FastAPI)
DOCUMENT_CALLBACK_ATTEMPTS=3
DOCUMENT_CALLBACK_RETRY_DELAY=0.25
