APP_NAME=study-agent-ai
APP_ENV=dev
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Must match study-agent-server/.env
INTERNAL_TOKEN=replace-with-a-random-internal-token
SPRING_BOOT_BASE_URL=http://localhost:8080
SPRING_BOOT_CONNECT_TIMEOUT=2
SPRING_BOOT_READ_TIMEOUT=30
# Maximum total deliveries per progress callback; retries only transport/408/429/5xx.
DOCUMENT_CALLBACK_ATTEMPTS=3
DOCUMENT_CALLBACK_RETRY_DELAY=0.25

# Use none for local fallback, or deepseek for the DeepSeek OpenAI-compatible API.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=30
TOOL_TIMEOUT=5
TOOL_MAX_CALLS=4
RAG_TOP_K=5
# Production/default: milvus. For explicitly ephemeral local tests only: memory.
VECTOR_STORE_PROVIDER=milvus
MILVUS_URI=http://localhost:19530
# Optional token for an existing authenticated Milvus deployment; never commit it.
MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_COLLECTION=study_agent_local_hash_v1
MILVUS_TIMEOUT=10
