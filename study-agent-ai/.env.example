APP_NAME=study-agent-ai
APP_ENV=dev
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Must match study-agent-server/.env
INTERNAL_TOKEN=replace-with-a-random-internal-token
SPRING_BOOT_BASE_URL=http://localhost:8080
SPRING_BOOT_CONNECT_TIMEOUT=2
SPRING_BOOT_READ_TIMEOUT=30

# Use none for local fallback, or deepseek for the DeepSeek OpenAI-compatible API.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=30
TOOL_TIMEOUT=5
TOOL_MAX_CALLS=4
RAG_TOP_K=5
VECTOR_STORE_PROVIDER=none
