<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.studyagent.project.mapper.AuditLogMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO sa_audit_log(project_id,actor_user_id,action,resource_type,resource_id,detail_json,request_id)
        VALUES(#{projectId},#{actorUserId},#{action},#{resourceType},#{resourceId},CAST(#{detailJson} AS JSON),#{requestId})
    </insert>
    <sql id="filters">
        WHERE project_id=#{projectId}
        <if test="query.action != null and query.action != ''">AND action=#{query.action}</if>
        <if test="query.resourceType != null and query.resourceType != ''">AND resource_type=#{query.resourceType}</if>
        <if test="query.userId != null">AND actor_user_id=#{query.userId}</if>
        <if test="query.startTime != null">AND create_time &gt;=#{query.startTime}</if>
        <if test="query.endTime != null">AND create_time &lt;=#{query.endTime}</if>
    </sql>
    <select id="count" resultType="long">SELECT COUNT(*) FROM sa_audit_log <include refid="filters"/></select>
    <select id="findPage" resultType="com.studyagent.project.entity.AuditLogEntity">
        SELECT * FROM sa_audit_log <include refid="filters"/>
        ORDER BY create_time DESC,id DESC LIMIT #{offset},#{query.pageSize}
    </select>
</mapper>
